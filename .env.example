# Supabase Public Configuration for HBPLUS App (Phase 1)
# Found in Supabase Dashboard -> Project Settings -> API
# Note: In Expo, only variables prefixed with EXPO_PUBLIC_ are exposed to the client application.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY or any secret key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key-here
